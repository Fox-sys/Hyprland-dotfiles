// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "output": ["DP-1"],
  // Modules need at least 34px (font + 2px borders); a smaller value is ignored with a warning
  "height": 34,
  "width": 2080,
  "spacing": 4,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["cpu", "memory", "temperature"],
  "modules-right": [
    "pulseaudio",
    "network",
    "hyprland/language",
    "tray",
    "clock",
    "custom/notification"
  ],

  // Waybar >= 0.16 dispatches clicks through hl.dsp.focus, so the built-in module works with the Lua config
  "hyprland/workspaces": {
    "format": "{id}{icon}",
    "format-icons": {
      "1": ": ",
      "2": ": ",
      "3": ": ",
      "4": ": 🎮",
      "8": ": ",
      "default": ""
    },
    "all-outputs": true,
    "sort-by-number": true,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'"
  },

  "cpu": {
    "interval": 2,
    "format": "{usage}% ",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false
  },

  "memory": {
    "interval": 5,
    "format": "{percentage}% ",
    "states": { "warning": 70, "critical": 90 },
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
  },

  // k10temp Tccd1; the absolute device path survives hwmonN renumbering between boots
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp3_input",
    "critical-threshold": 88,
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", ""],
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc}"
  },

  // Pinned to the wired NIC, otherwise waybar may report a docker/libvirt bridge
  "network": {
    "interface": "enp42s0",
    "interval": 5,
    "format-ethernet": "{ipaddr} | {bandwidthUpBits} ⇑ {bandwidthDownBits} ⇓",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway {gwaddr}"
  },

  "hyprland/language": {
    "format-en": "EN",
    "format-ru": "RU"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%OS}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "weekdays": "<span color='#A74E82'><b>{}</b></span>",
        "today": "<span color='#A74E82'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#eb4d4b'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='#eb4d4b'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='#eb4d4b'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='#eb4d4b'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
